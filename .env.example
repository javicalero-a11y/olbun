# Copy to .env.local for the Next.js app and .env for Prisma CLI commands.
# Every variable here is validated at boot by lib/env.ts — the app refuses to
# start if one is missing or malformed.

# NODE_ENV is set by the Next.js and test runners, not here — Next ignores it in
# .env files by design.

# The app connects as the unprivileged role so RLS applies (see the app_role
# migration). Migrations and seeds use the owner role instead.
DATABASE_URL=postgresql://olbun_app:olbun_app_dev_only@localhost:5433/olbun?schema=public
DIRECT_DATABASE_URL=postgresql://olbun:olbun@localhost:5433/olbun?schema=public

# Port 3100 keeps Olbun clear of other local Next.js projects on 3000.
APP_URL=http://localhost:3100

LOG_LEVEL=debug

# Firma de las sesiones. Genera uno con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-un-secreto-de-32-bytes

# Cifra secretos TOTP y datos personales. Genera una con: openssl rand -base64 32
ENCRYPTION_KEY=cambia-esto-por-32-bytes-en-base64

# --- Entrar con Google (opcional) ---------------------------------------
# Sin estas dos, la aplicación arranca igual y simplemente no ofrece el botón.
# Se crean en https://console.cloud.google.com/apis/credentials
# URI de redirección autorizado: http://localhost:3100/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Entrar con Microsoft (opcional) ------------------------------------
# Registro de aplicación en https://entra.microsoft.com
#   Identity > Applications > App registrations > New registration
#   Cuentas admitidas: "Cualquier directorio organizativo (multiinquilino)"
#   URI de redirección (tipo Web):
#     http://127.0.0.1:3100/api/auth/callback/microsoft-entra-id
# El secreto se crea en "Certificates & secrets" y CADUCA: apunta la fecha.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Opcional: restringe el acceso a un único directorio. Sin esto entra cualquier
# organización con Entra, que es lo que quiere un producto multiempresa.
# MICROSOFT_TENANT_ID=

# --- Enlace mágico por correo -------------------------------------------
# Remitente de los enlaces de acceso. En desarrollo el enlace se escribe en la
# consola y no se envía nada, así que esto sólo importa en producción.
# AUTH_EMAIL_FROM=no-reply@olbun.es

# --- Detección (M7) ------------------------------------------------------
# Clave de la API de Anthropic. Sin ella el producto sigue funcionando: se usa
# un motor de reglas local, más flojo, y cada detección guarda cuál de los dos
# la propuso, así que siempre se sabe.
# ANTHROPIC_API_KEY=

# Fuerza un motor concreto: "claude" o "reglas". La suite de extremo a extremo
# lo fija en "reglas" para no depender de la red ni gastar dinero al pasarla.
# MOTOR_DETECCION=

# --- Almacenamiento de documentos (M9) -----------------------------------
# MinIO en desarrollo (docker compose lo levanta), S3 o equivalente en
# producción. Sólo cambian el endpoint y las credenciales.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=olbun-documentos
S3_ACCESS_KEY=olbun
S3_SECRET_KEY=olbun-desarrollo
