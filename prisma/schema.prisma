// Olbun — Prisma schema.
//
// Conventions (see AGENTS.md and SPEC §4):
//   * Primary keys are cuid2.
//   * Domain nouns stay in Spanish where the Spanish word is the legal term of
//     art (Expediente, Plazo, Notificacion). Generic infrastructure is English.
//   * Every tenant-owned model carries organisationId + the audit columns and a
//     composite index beginning with organisationId.
//   * Append-only models are exempt from updatedAt/deletedAt — see ADR 0003.
//
// M0: Organisation. M1: identity, membership, teams, scoped access.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The application connects as a non-superuser so row-level security applies.
  url       = env("DATABASE_URL")
  // Migrations and seeds need the owner role, which RLS does not constrain.
  directUrl = env("DIRECT_DATABASE_URL")
}

/// Commercial plan for an organisation. Placeholder tiers until billing is
/// specified; only used for feature gating from M13 onwards.
enum SubscriptionTier {
  TRIAL
  STANDARD
  PROFESSIONAL
  ENTERPRISE
}

/// Roles reflect how Spanish public-service contractors are actually organised
/// (SPEC §1). The permission each one carries is defined in lib/auth/matrix.ts,
/// never inline in a query.
enum Role {
  /// Full control including billing and deleting the organisation.
  OWNER
  /// Everything except billing and organisation deletion.
  ORG_ADMIN
  /// Responsable de contrato — scoped to their own contracts.
  GESTOR_CONTRATO
  /// Asesoría jurídica interna — all expedientes, plazos and escritos.
  JURIDICO
  /// Despacho externo — read-mostly, scoped by AccessGrant, time-boxed.
  LETRADO_EXTERNO
  /// Calidad y PRL — incidencias, riesgos, acciones correctoras.
  CALIDAD
  /// RRHH y relaciones laborales — plantilla, ausencias, subrogación.
  RRHH
  /// Administración — facturación, morosidad, provisiones.
  ADMIN_CONTABLE
  /// Frontline — reports incidents, completes assigned tasks.
  CONTRIBUTOR
  /// Read-only across the organisation.
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// What an AccessGrant is scoped to. Used for external counsel, who must see
/// exactly their expedientes and nothing else.
enum AccessScopeType {
  EXPEDIENTE
  CONTRATO
  ORGANISATION
}

/// The tenant root. Every other tenant-owned record hangs off this via
/// organisationId and is filtered by the tenant-scoped data access layer.
model Organisation {
  id   String @id @default(cuid(2))
  name String
  /// URL-safe identifier used in every authenticated route: /[orgSlug]/...
  slug String @unique

  logoUrl String?

  /// NIF de la empresa.
  nif             String?
  cnae            String?
  domicilioSocial String?
  /// Código ROLECE (Registro Oficial de Licitadores).
  codigoRolece    String?

  /// IANA timezone. Date-only comparisons for plazos happen in this zone.
  timezone             String @default("Europe/Madrid")
  locale               String @default("es-ES")
  /// ISO 4217. Cross-currency aggregation is out of scope for v1.
  currency             String @default("EUR")
  /// Mes de inicio del ejercicio fiscal, 1–12. En España coincide con el año natural.
  fiscalYearStartMonth Int    @default(1)

  subscriptionTier SubscriptionTier @default(TRIAL)

  /// Tenant-configurable settings that do not warrant their own columns.
  settings Json @default("{}")

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships          Membership[]
  teams                Team[]
  accessGrants         AccessGrant[]
  poderesAdjudicadores PoderAdjudicador[]
  contratos            Contrato[]

  @@index([deletedAt])
  @@map("organisations")
}

/// A person. Users are global: the same person may belong to several
/// organisations, so nothing tenant-specific lives here — that is Membership.
model User {
  id String @id @default(cuid(2))

  /// Stored lowercased; uniqueness is enforced case-insensitively by a
  /// functional index in the migration.
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String
  avatarUrl       String?
  phone           String?
  jobTitle        String?

  locale String @default("es-ES")

  /// TOTP. Mandatory for OWNER and ORG_ADMIN (SPEC §7.4); the secret is
  /// encrypted at rest and never returned by the data access layer.
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  mfaEnrolledAt    DateTime?
  mfaRecoveryCodes String[]

  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships       Membership[]
  sessions          Session[]
  accounts          Account[]
  invitationsSent   Membership[]  @relation("InvitedBy")
  accessGrants      AccessGrant[] @relation("Grantee")
  accessGrantsGiven AccessGrant[] @relation("GrantedBy")

  @@index([deletedAt])
  @@map("users")
}

/// The join between a person and an organisation, carrying their role. This is
/// the row the session resolves to, and the anchor for every permission check.
model Membership {
  id             String @id @default(cuid(2))
  userId         String
  organisationId String

  role   Role
  status MembershipStatus @default(INVITED)

  /// Single-use invitation token, stored hashed. Cleared on acceptance.
  invitationTokenHash String?   @unique
  invitationExpiresAt DateTime?
  invitedById         String?
  invitedAt           DateTime?
  acceptedAt          DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  teamMembers  TeamMember[]

  @@unique([userId, organisationId])
  @@index([organisationId, status])
  @@index([organisationId, role])
  @@index([userId])
  @@index([invitedById])
  @@map("memberships")
}

/// Teams group people for assignment and for scoped access — a GESTOR_CONTRATO
/// reaches the contracts assigned to their team as well as their own.
model Team {
  id             String  @id @default(cuid(2))
  organisationId String
  name           String
  description    String?
  parentTeamId   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  parentTeam   Team?        @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  childTeams   Team[]       @relation("TeamHierarchy")
  members      TeamMember[]

  @@unique([organisationId, name])
  @@index([organisationId, deletedAt])
  @@index([parentTeamId])
  @@map("teams")
}

model TeamMember {
  id           String  @id @default(cuid(2))
  teamId       String
  membershipId String
  roleInTeam   String?
  isLead       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([teamId, membershipId])
  @@index([membershipId])
  @@map("team_members")
}

/// Time-boxed, explicitly scoped access — the mechanism behind LETRADO_EXTERNO.
/// A grant never widens a role; it only makes specific records reachable.
model AccessGrant {
  id             String @id @default(cuid(2))
  organisationId String
  granteeUserId  String

  scopeType AccessScopeType
  /// Ids of the scoped records. Replaced by a child table if a grant ever needs
  /// per-record attributes; see ADR 0004 on why this is the one tolerated
  /// exception — these are opaque references validated at resolution time, not
  /// a modelled association.
  scopeIds  String[]

  startsAt  DateTime
  expiresAt DateTime
  revokedAt DateTime?
  reason    String

  grantedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  grantee      User         @relation("Grantee", fields: [granteeUserId], references: [id], onDelete: Cascade)
  grantedBy    User         @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([organisationId, granteeUserId])
  @@index([granteeUserId, expiresAt])
  @@index([grantedById])
  @@map("access_grants")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) adapter models. Shapes are fixed by the adapter.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid(2))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid(2))
  sessionToken String   @unique
  userId       String
  expires      DateTime

  /// Which organisation this session is currently acting in. Switching orgs
  /// rewrites this, so a session is always unambiguously single-tenant.
  activeOrganisationId String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Scope of a holiday calendar. A day is inhábil if any applicable layer says
/// so — national, autonomous or municipal.
enum AmbitoCalendario {
  NACIONAL
  AUTONOMICO
  LOCAL
}

/// Holiday calendars are public reference data, not tenant data: the calendar
/// for Sevilla is the same for every customer operating there, so it is stored
/// once and shared. No organisationId, and no row-level security.
model Calendario {
  id     String           @id @default(cuid(2))
  anio   Int
  ambito AmbitoCalendario
  /// Empty for NACIONAL, the CCAA code for AUTONOMICO, the INE municipality
  /// code for LOCAL.
  codigo String           @default("")
  nombre String

  /// Where the data came from — a BOE or boletín autonómico reference.
  fuente String?

  /// Until a person checks the calendar against its official source, every
  /// deadline computed from it is reported as incomplete (SPEC §6.1).
  verificadoEn    DateTime?
  verificadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  festivos Festivo[]

  @@unique([anio, ambito, codigo])
  @@index([ambito, codigo])
  @@map("calendarios")
}

model Festivo {
  id           String   @id @default(cuid(2))
  calendarioId String
  /// Stored as a date, never a timestamp: a holiday is a calendar day, and a
  /// timestamp would drag a timezone into a computation that must not have one.
  fecha        DateTime @db.Date
  nombre       String

  calendario Calendario @relation(fields: [calendarioId], references: [id], onDelete: Cascade)

  @@unique([calendarioId, fecha])
  @@index([fecha])
  @@map("festivos")
}

// ---------------------------------------------------------------------------
// M4 — Poderes adjudicadores y contratos (LCSP, Ley 9/2017)
// ---------------------------------------------------------------------------

/// Type of contracting authority. Drawn from how the Spanish public sector is
/// actually organised, because the type drives which sede electrónica a
/// notification arrives through and which boletín publishes its calendar.
enum TipoPoderAdjudicador {
  AYUNTAMIENTO
  DIPUTACION
  CABILDO_CONSELL
  COMUNIDAD_AUTONOMA
  ADMINISTRACION_GENERAL_ESTADO
  ORGANISMO_AUTONOMO
  ENTIDAD_PUBLICA_EMPRESARIAL
  SERVICIO_SALUD
  UNIVERSIDAD
  CONSORCIO
  MANCOMUNIDAD
  EMPRESA_PUBLICA
  OTRO
}

/// Contract type — art. 12 y ss. LCSP.
enum TipoContrato {
  SERVICIOS
  OBRAS
  SUMINISTROS
  CONCESION_SERVICIOS
  CONCESION_OBRAS
  MIXTO
  PRIVADO
}

/// Award procedure — art. 131 y ss. LCSP.
enum ProcedimientoAdjudicacion {
  ABIERTO
  ABIERTO_SIMPLIFICADO
  ABIERTO_SIMPLIFICADO_ABREVIADO
  RESTRINGIDO
  NEGOCIADO_SIN_PUBLICIDAD
  LICITACION_CON_NEGOCIACION
  DIALOGO_COMPETITIVO
  ASOCIACION_INNOVACION
  CONTRATO_MENOR
  ACUERDO_MARCO
  SISTEMA_DINAMICO
  ENCARGO_MEDIO_PROPIO
}

enum EstadoContrato {
  LICITACION
  ADJUDICADO
  FORMALIZADO
  EN_EJECUCION
  PRORROGADO
  SUSPENDIDO
  EN_LIQUIDACION
  FINALIZADO
  RESUELTO
  PERDIDO
}

enum TipoModificado {
  MODIFICADO_PREVISTO
  MODIFICADO_NO_PREVISTO
  REVISION_PRECIOS
  REEQUILIBRIO
  PRORROGA
  SUSPENSION
  CESION
}

enum EstadoModificado {
  BORRADOR
  SOLICITADO
  EN_TRAMITE
  APROBADO
  DENEGADO
  RETIRADO
}

/// The public body on the other side of the contract.
model PoderAdjudicador {
  id             String @id @default(cuid(2))
  organisationId String

  nombre     String
  nif        String?
  /// Código DIR3 (Directorio Común de Unidades Orgánicas) — the stable public
  /// identifier, and how a notification is matched back to an authority.
  codigoDir3 String?
  tipo       TipoPoderAdjudicador

  comunidadAutonoma String?
  provincia         String?
  /// Código INE del municipio. Decides which local holiday calendar applies to
  /// deadlines in this authority's procedures.
  municipioIne      String?
  municipioNombre   String?

  sedeElectronicaUrl   String?
  perfilContratanteUrl String?
  notas                String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contactos    ContactoPoderAdjudicador[]
  contratos    Contrato[]

  @@index([organisationId, deletedAt])
  @@index([organisationId, nombre])
  @@index([organisationId, codigoDir3])
  @@map("poderes_adjudicadores")
}

model ContactoPoderAdjudicador {
  id                 String @id @default(cuid(2))
  organisationId     String
  poderAdjudicadorId String

  nombre                String
  cargo                 String?
  email                 String?
  telefono              String?
  /// Responsable del contrato designado por el órgano (art. 62 LCSP).
  esResponsableContrato Boolean @default(false)
  esEscalado            Boolean @default(false)
  notas                 String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  poderAdjudicador PoderAdjudicador @relation(fields: [poderAdjudicadorId], references: [id], onDelete: Cascade)

  @@index([organisationId, poderAdjudicadorId])
  @@map("contactos_poder_adjudicador")
}

model Contrato {
  id             String @id @default(cuid(2))
  organisationId String

  /// Nº de expediente del órgano de contratación — how the authority refers to
  /// it in every notification, so it is the key people actually search by.
  numeroExpediente String
  objeto           String
  descripcion      String?

  poderAdjudicadorId String
  tipo               TipoContrato
  procedimiento      ProcedimientoAdjudicacion
  estado             EstadoContrato            @default(LICITACION)

  lote         String?
  /// Common Procurement Vocabulary codes.
  cpv          String[]
  enlacePlacsp String?

  fechaAdjudicacion    DateTime? @db.Date
  fechaFormalizacion   DateTime? @db.Date
  fechaInicio          DateTime? @db.Date
  duracionInicialMeses Int?
  fechaFinPrevista     DateTime? @db.Date

  /// Prórrogas previstas en el pliego: número, duración y preaviso en días.
  prorrogasPrevistas   Json?
  preavisoProrrogaDias Int?

  importeAdjudicacion Decimal? @db.Decimal(14, 2)
  importeLicitacion   Decimal? @db.Decimal(14, 2)
  tipoIva             Decimal? @db.Decimal(5, 2)

  hayRevisionPrecios Boolean @default(false)
  formulaRevision    String?

  garantiaDefinitiva Decimal? @db.Decimal(14, 2)
  plazoGarantiaMeses Int?

  /// Subrogación de personal impuesta por el pliego o el convenio — the single
  /// biggest source of labour litigation in this sector.
  haySubrogacionPersonal Boolean @default(false)

  /// Régimen de penalidades del pliego, para calcular la exposición.
  regimenPenalidades Json?

  responsableInternoId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  poderAdjudicador PoderAdjudicador @relation(fields: [poderAdjudicadorId], references: [id], onDelete: Restrict)
  modificados      Modificado[]

  @@unique([organisationId, numeroExpediente])
  @@index([organisationId, estado])
  @@index([organisationId, deletedAt])
  @@index([organisationId, fechaFinPrevista])
  @@index([poderAdjudicadorId])
  @@map("contratos")
}

model Modificado {
  id             String @id @default(cuid(2))
  organisationId String
  contratoId     String

  referencia  String?
  tipo        TipoModificado
  estado      EstadoModificado @default(BORRADOR)
  descripcion String

  importe                     Decimal? @db.Decimal(14, 2)
  porcentajeSobreAdjudicacion Decimal? @db.Decimal(6, 3)
  mesesAmpliacion             Int?

  fechaSolicitud  DateTime? @db.Date
  fechaAprobacion DateTime? @db.Date

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([organisationId, contratoId])
  @@index([organisationId, estado])
  @@map("modificados")
}
