// Olbun — Prisma schema.
//
// Conventions (see AGENTS.md and SPEC §4):
//   * Primary keys are cuid2.
//   * Domain nouns stay in Spanish where the Spanish word is the legal term of
//     art (Expediente, Plazo, Notificacion). Generic infrastructure is English.
//   * Every tenant-owned model carries organisationId + the audit columns and a
//     composite index beginning with organisationId.
//   * Append-only models are exempt from updatedAt/deletedAt — see ADR 0003.
//
// M0: Organisation. M1: identity, membership, teams, scoped access.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The application connects as a non-superuser so row-level security applies.
  url       = env("DATABASE_URL")
  // Migrations and seeds need the owner role, which RLS does not constrain.
  directUrl = env("DIRECT_DATABASE_URL")
}

/// Commercial plan for an organisation. Placeholder tiers until billing is
/// specified; only used for feature gating from M13 onwards.
enum SubscriptionTier {
  TRIAL
  STANDARD
  PROFESSIONAL
  ENTERPRISE
}

/// Roles reflect how Spanish public-service contractors are actually organised
/// (SPEC §1). The permission each one carries is defined in lib/auth/matrix.ts,
/// never inline in a query.
enum Role {
  /// Full control including billing and deleting the organisation.
  OWNER
  /// Everything except billing and organisation deletion.
  ORG_ADMIN
  /// Responsable de contrato — scoped to their own contracts.
  GESTOR_CONTRATO
  /// Asesoría jurídica interna — all expedientes, plazos and escritos.
  JURIDICO
  /// Despacho externo — read-mostly, scoped by AccessGrant, time-boxed.
  LETRADO_EXTERNO
  /// Calidad y PRL — incidencias, riesgos, acciones correctoras.
  CALIDAD
  /// RRHH y relaciones laborales — plantilla, ausencias, subrogación.
  RRHH
  /// Administración — facturación, morosidad, provisiones.
  ADMIN_CONTABLE
  /// Frontline — reports incidents, completes assigned tasks.
  CONTRIBUTOR
  /// Read-only across the organisation.
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// What an AccessGrant is scoped to. Used for external counsel, who must see
/// exactly their expedientes and nothing else.
enum AccessScopeType {
  EXPEDIENTE
  CONTRATO
  ORGANISATION
}

/// The tenant root. Every other tenant-owned record hangs off this via
/// organisationId and is filtered by the tenant-scoped data access layer.
model Organisation {
  id   String @id @default(cuid(2))
  name String
  /// URL-safe identifier used in every authenticated route: /[orgSlug]/...
  slug String @unique

  logoUrl String?

  /// NIF de la empresa.
  nif             String?
  cnae            String?
  domicilioSocial String?
  /// Código ROLECE (Registro Oficial de Licitadores).
  codigoRolece    String?

  /// IANA timezone. Date-only comparisons for plazos happen in this zone.
  timezone             String @default("Europe/Madrid")
  locale               String @default("es-ES")
  /// ISO 4217. Cross-currency aggregation is out of scope for v1.
  currency             String @default("EUR")
  /// Mes de inicio del ejercicio fiscal, 1–12. En España coincide con el año natural.
  fiscalYearStartMonth Int    @default(1)

  subscriptionTier SubscriptionTier @default(TRIAL)

  /// Tenant-configurable settings that do not warrant their own columns.
  settings Json @default("{}")

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships           Membership[]
  teams                 Team[]
  accessGrants          AccessGrant[]
  poderesAdjudicadores  PoderAdjudicador[]
  contratos             Contrato[]
  plantillas            PlantillaProcedimiento[]
  expedientes           Expediente[]
  auditEvents           AuditEvent[]
  buzones               BuzonConectado[]
  solicitudesOAuthBuzon SolicitudOAuthBuzon[]
  lotesDeteccion        LoteDeteccion[]
  itemsLoteDeteccion    ItemLoteDeteccion[]
  comunicaciones        Comunicacion[]
  adjuntos              Adjunto[]
  detecciones           Deteccion[]
  incidencias           Incidencia[]
  riesgos               Riesgo[]
  bandasRiesgo          BandaRiesgo[]
  categoriasRiesgo      CategoriaRiesgo[]
  controlesRiesgo       ControlRiesgo[]
  valoracionesRiesgo    ValoracionRiesgo[]
  revisionesRiesgo      RevisionRiesgo[]
  accionesCorrectoras   AccionCorrectora[]
  tiposDocumento        TipoDocumento[]
  documentos            Documento[]
  versionesDocumento    VersionDocumento[]
  conveniosColectivos   ConvenioColectivo[]
  categoriasProfesional CategoriaProfesional[]
  tablasSalariales      TablaSalarial[]
  empleados             Empleado[]
  conveniosContrato     ContratoConvenio[]
  adscripcionesContrato AdscripcionContrato[]
  plantillasExigidas    PlantillaExigida[]
  tiposCertificacion    TipoCertificacion[]
  certificaciones       CertificacionEmpleado[]

  @@index([deletedAt])
  @@map("organisations")
}

/// A person. Users are global: the same person may belong to several
/// organisations, so nothing tenant-specific lives here — that is Membership.
model User {
  id String @id @default(cuid(2))

  /// Stored lowercased; uniqueness is enforced case-insensitively by a
  /// functional index in the migration.
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String
  avatarUrl       String?
  phone           String?
  jobTitle        String?

  locale String @default("es-ES")

  /// TOTP. Mandatory for OWNER and ORG_ADMIN (SPEC §7.4); the secret is
  /// encrypted at rest and never returned by the data access layer.
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?
  mfaEnrolledAt    DateTime?
  mfaRecoveryCodes String[]

  lastLoginAt      DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships       Membership[]
  sessions          Session[]
  accounts          Account[]
  invitationsSent   Membership[]  @relation("InvitedBy")
  accessGrants      AccessGrant[] @relation("Grantee")
  accessGrantsGiven AccessGrant[] @relation("GrantedBy")

  @@index([deletedAt])
  @@map("users")
}

/// The join between a person and an organisation, carrying their role. This is
/// the row the session resolves to, and the anchor for every permission check.
model Membership {
  id             String @id @default(cuid(2))
  userId         String
  organisationId String

  role   Role
  status MembershipStatus @default(INVITED)

  /// Single-use invitation token, stored hashed. Cleared on acceptance.
  invitationTokenHash String?   @unique
  invitationExpiresAt DateTime?
  invitedById         String?
  invitedAt           DateTime?
  acceptedAt          DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  teamMembers  TeamMember[]

  @@unique([userId, organisationId])
  @@index([organisationId, status])
  @@index([organisationId, role])
  @@index([userId])
  @@index([invitedById])
  @@map("memberships")
}

/// Teams group people for assignment and for scoped access — a GESTOR_CONTRATO
/// reaches the contracts assigned to their team as well as their own.
model Team {
  id             String  @id @default(cuid(2))
  organisationId String
  name           String
  description    String?
  parentTeamId   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  parentTeam   Team?        @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  childTeams   Team[]       @relation("TeamHierarchy")
  members      TeamMember[]

  @@unique([organisationId, name])
  @@index([organisationId, deletedAt])
  @@index([parentTeamId])
  @@map("teams")
}

model TeamMember {
  id           String  @id @default(cuid(2))
  teamId       String
  membershipId String
  roleInTeam   String?
  isLead       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([teamId, membershipId])
  @@index([membershipId])
  @@map("team_members")
}

/// Time-boxed, explicitly scoped access — the mechanism behind LETRADO_EXTERNO.
/// A grant never widens a role; it only makes specific records reachable.
model AccessGrant {
  id             String @id @default(cuid(2))
  organisationId String
  granteeUserId  String

  scopeType AccessScopeType
  /// Ids of the scoped records. Replaced by a child table if a grant ever needs
  /// per-record attributes; see ADR 0004 on why this is the one tolerated
  /// exception — these are opaque references validated at resolution time, not
  /// a modelled association.
  scopeIds  String[]

  startsAt  DateTime
  expiresAt DateTime
  revokedAt DateTime?
  reason    String

  grantedById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  grantee      User         @relation("Grantee", fields: [granteeUserId], references: [id], onDelete: Cascade)
  grantedBy    User         @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([organisationId, granteeUserId])
  @@index([granteeUserId, expiresAt])
  @@index([grantedById])
  @@map("access_grants")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) adapter models. Shapes are fixed by the adapter.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid(2))
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid(2))
  sessionToken String   @unique
  userId       String
  expires      DateTime

  /// Which organisation this session is currently acting in. Switching orgs
  /// rewrites this, so a session is always unambiguously single-tenant.
  activeOrganisationId String?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Scope of a holiday calendar. A day is inhábil if any applicable layer says
/// so — national, autonomous or municipal.
enum AmbitoCalendario {
  NACIONAL
  AUTONOMICO
  LOCAL
}

/// Holiday calendars are public reference data, not tenant data: the calendar
/// for Sevilla is the same for every customer operating there, so it is stored
/// once and shared. No organisationId, and no row-level security.
model Calendario {
  id     String           @id @default(cuid(2))
  anio   Int
  ambito AmbitoCalendario
  /// Empty for NACIONAL, the CCAA code for AUTONOMICO, the INE municipality
  /// code for LOCAL.
  codigo String           @default("")
  nombre String

  /// Where the data came from — a BOE or boletín autonómico reference.
  fuente String?

  /// Until a person checks the calendar against its official source, every
  /// deadline computed from it is reported as incomplete (SPEC §6.1).
  verificadoEn    DateTime?
  verificadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  festivos Festivo[]

  @@unique([anio, ambito, codigo])
  @@index([ambito, codigo])
  @@map("calendarios")
}

model Festivo {
  id           String   @id @default(cuid(2))
  calendarioId String
  /// Stored as a date, never a timestamp: a holiday is a calendar day, and a
  /// timestamp would drag a timezone into a computation that must not have one.
  fecha        DateTime @db.Date
  nombre       String

  calendario Calendario @relation(fields: [calendarioId], references: [id], onDelete: Cascade)

  @@unique([calendarioId, fecha])
  @@index([fecha])
  @@map("festivos")
}

// ---------------------------------------------------------------------------
// M4 — Poderes adjudicadores y contratos (LCSP, Ley 9/2017)
// ---------------------------------------------------------------------------

/// Type of contracting authority. Drawn from how the Spanish public sector is
/// actually organised, because the type drives which sede electrónica a
/// notification arrives through and which boletín publishes its calendar.
enum TipoPoderAdjudicador {
  AYUNTAMIENTO
  DIPUTACION
  CABILDO_CONSELL
  COMUNIDAD_AUTONOMA
  ADMINISTRACION_GENERAL_ESTADO
  ORGANISMO_AUTONOMO
  ENTIDAD_PUBLICA_EMPRESARIAL
  SERVICIO_SALUD
  UNIVERSIDAD
  CONSORCIO
  MANCOMUNIDAD
  EMPRESA_PUBLICA
  OTRO
}

/// Contract type — art. 12 y ss. LCSP.
enum TipoContrato {
  SERVICIOS
  OBRAS
  SUMINISTROS
  CONCESION_SERVICIOS
  CONCESION_OBRAS
  MIXTO
  PRIVADO
}

/// Award procedure — art. 131 y ss. LCSP.
enum ProcedimientoAdjudicacion {
  ABIERTO
  ABIERTO_SIMPLIFICADO
  ABIERTO_SIMPLIFICADO_ABREVIADO
  RESTRINGIDO
  NEGOCIADO_SIN_PUBLICIDAD
  LICITACION_CON_NEGOCIACION
  DIALOGO_COMPETITIVO
  ASOCIACION_INNOVACION
  CONTRATO_MENOR
  ACUERDO_MARCO
  SISTEMA_DINAMICO
  ENCARGO_MEDIO_PROPIO
}

enum EstadoContrato {
  LICITACION
  ADJUDICADO
  FORMALIZADO
  EN_EJECUCION
  PRORROGADO
  SUSPENDIDO
  EN_LIQUIDACION
  FINALIZADO
  RESUELTO
  PERDIDO
}

enum TipoModificado {
  MODIFICADO_PREVISTO
  MODIFICADO_NO_PREVISTO
  REVISION_PRECIOS
  REEQUILIBRIO
  PRORROGA
  SUSPENSION
  CESION
}

enum EstadoModificado {
  BORRADOR
  SOLICITADO
  EN_TRAMITE
  APROBADO
  DENEGADO
  RETIRADO
}

/// The public body on the other side of the contract.
model PoderAdjudicador {
  id             String @id @default(cuid(2))
  organisationId String

  nombre     String
  nif        String?
  /// Código DIR3 (Directorio Común de Unidades Orgánicas) — the stable public
  /// identifier, and how a notification is matched back to an authority.
  codigoDir3 String?
  tipo       TipoPoderAdjudicador

  comunidadAutonoma String?
  provincia         String?
  /// Código INE del municipio. Decides which local holiday calendar applies to
  /// deadlines in this authority's procedures.
  municipioIne      String?
  municipioNombre   String?

  sedeElectronicaUrl   String?
  perfilContratanteUrl String?
  notas                String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contactos    ContactoPoderAdjudicador[]
  contratos    Contrato[]

  @@index([organisationId, deletedAt])
  @@index([organisationId, nombre])
  @@index([organisationId, codigoDir3])
  @@map("poderes_adjudicadores")
}

model ContactoPoderAdjudicador {
  id                 String @id @default(cuid(2))
  organisationId     String
  poderAdjudicadorId String

  nombre                String
  cargo                 String?
  email                 String?
  telefono              String?
  /// Responsable del contrato designado por el órgano (art. 62 LCSP).
  esResponsableContrato Boolean @default(false)
  esEscalado            Boolean @default(false)
  notas                 String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  poderAdjudicador PoderAdjudicador @relation(fields: [poderAdjudicadorId], references: [id], onDelete: Cascade)

  @@index([organisationId, poderAdjudicadorId])
  @@map("contactos_poder_adjudicador")
}

model Contrato {
  id             String @id @default(cuid(2))
  organisationId String

  /// Nº de expediente del órgano de contratación — how the authority refers to
  /// it in every notification, so it is the key people actually search by.
  numeroExpediente String
  objeto           String
  descripcion      String?

  poderAdjudicadorId String
  tipo               TipoContrato
  procedimiento      ProcedimientoAdjudicacion
  estado             EstadoContrato            @default(LICITACION)

  lote         String?
  /// Common Procurement Vocabulary codes.
  cpv          String[]
  enlacePlacsp String?

  fechaAdjudicacion    DateTime? @db.Date
  fechaFormalizacion   DateTime? @db.Date
  fechaInicio          DateTime? @db.Date
  duracionInicialMeses Int?
  fechaFinPrevista     DateTime? @db.Date

  /// Prórrogas previstas en el pliego: número, duración y preaviso en días.
  prorrogasPrevistas   Json?
  preavisoProrrogaDias Int?

  importeAdjudicacion Decimal? @db.Decimal(14, 2)
  importeLicitacion   Decimal? @db.Decimal(14, 2)
  tipoIva             Decimal? @db.Decimal(5, 2)

  hayRevisionPrecios Boolean @default(false)
  formulaRevision    String?

  garantiaDefinitiva Decimal? @db.Decimal(14, 2)
  plazoGarantiaMeses Int?

  /// Subrogación de personal impuesta por el pliego o el convenio — the single
  /// biggest source of labour litigation in this sector.
  haySubrogacionPersonal Boolean @default(false)

  /// Régimen de penalidades del pliego, para calcular la exposición.
  regimenPenalidades Json?

  responsableInternoId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  poderAdjudicador PoderAdjudicador @relation(fields: [poderAdjudicadorId], references: [id], onDelete: Restrict)
  modificados      Modificado[]
  expedientes      Expediente[]

  buzones                    BuzonConectado[]
  comunicaciones             Comunicacion[]
  incidencias                Incidencia[]
  riesgos                    Riesgo[]
  documentos                 Documento[]
  convenios                  ContratoConvenio[]
  adscripciones              AdscripcionContrato[]
  plantillaExigida           PlantillaExigida[]
  empleadosOrigenSubrogacion Empleado[]            @relation("ContratoOrigenSubrogacion")

  @@unique([organisationId, numeroExpediente])
  @@index([organisationId, estado])
  @@index([organisationId, deletedAt])
  @@index([organisationId, fechaFinPrevista])
  @@index([poderAdjudicadorId])
  @@map("contratos")
}

model Modificado {
  id             String @id @default(cuid(2))
  organisationId String
  contratoId     String

  referencia  String?
  tipo        TipoModificado
  estado      EstadoModificado @default(BORRADOR)
  descripcion String

  importe                     Decimal? @db.Decimal(14, 2)
  porcentajeSobreAdjudicacion Decimal? @db.Decimal(6, 3)
  mesesAmpliacion             Int?

  fechaSolicitud  DateTime? @db.Date
  fechaAprobacion DateTime? @db.Date

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@index([organisationId, contratoId])
  @@index([organisationId, estado])
  @@map("modificados")
}

// ---------------------------------------------------------------------------
// M5 — Expedientes, hitos y plazos
// ---------------------------------------------------------------------------

enum Jurisdiccion {
  ADMINISTRATIVA
  CONTENCIOSO_ADMINISTRATIVA
  SOCIAL
  CIVIL
  PENAL
  ARBITRAJE
  EXTRAJUDICIAL
}

enum TipoExpediente {
  // Vía contractual
  PENALIDAD
  EXPEDIENTE_SANCIONADOR
  RESOLUCION_CONTRATO
  MODIFICADO
  REEQUILIBRIO_ECONOMICO
  REVISION_PRECIOS
  LIQUIDACION
  DEVOLUCION_GARANTIA
  IMPAGO_MOROSIDAD
  // Vía de impugnación
  RECURSO_ESPECIAL_CONTRATACION
  RECURSO_ALZADA
  RECURSO_REPOSICION
  RECURSO_CONTENCIOSO
  // Vía laboral
  SUBROGACION
  DESPIDO
  RECLAMACION_CANTIDAD
  CONFLICTO_COLECTIVO
  SANCION_ITSS
  // Terceros
  RESPONSABILIDAD_PATRIMONIAL
  RECLAMACION_TERCERO
}

enum EstadoExpediente {
  BORRADOR
  ABIERTO
  EN_TRAMITE
  SUSPENDIDO
  PENDIENTE_RESOLUCION
  RESUELTO
  RECURRIDO
  ARCHIVADO
}

enum SentidoResolucion {
  ESTIMATORIA_TOTAL
  ESTIMATORIA_PARCIAL
  DESESTIMATORIA
  ALLANAMIENTO
  DESISTIMIENTO
  ACUERDO
  CADUCIDAD
  INADMISION
}

enum TipoHito {
  RECEPCION_NOTIFICACION
  PRESENTACION_ESCRITO
  PRUEBA
  VISTA_JUICIO
  RESOLUCION
  PAGO
  ACTUACION_INTERNA
}

enum EstadoHito {
  PENDIENTE
  EN_CURSO
  CUMPLIDO
  VENCIDO
  NO_APLICA
}

/// Mirrors the `Computo` union in lib/domain/plazos. The two are kept in step
/// by a test that compares them.
enum ComputoPlazo {
  HABILES_ADMINISTRATIVO
  HABILES_JUDICIAL
  NATURALES
  MESES
  ANOS
}

enum EstadoPlazo {
  VIGENTE
  CUMPLIDO
  VENCIDO
  SUSPENDIDO
  AMPLIADO
}

/// A procedure template: the standard sequence of steps for one kind of
/// expediente. Opening an expediente instantiates its template, so the whole
/// timeline exists from minute one instead of being typed in by hand. This is
/// where the product's leverage lives.
model PlantillaProcedimiento {
  id             String @id @default(cuid(2))
  organisationId String

  nombre       String
  tipo         TipoExpediente
  jurisdiccion Jurisdiccion
  descripcion  String?
  /// Templates seeded by Olbun are shared starting points; a tenant may edit
  /// them, at which point they own the copy.
  esDelSistema Boolean        @default(false)
  activa       Boolean        @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  hitos        PlantillaHito[]
  expedientes  Expediente[]

  @@unique([organisationId, tipo, nombre])
  @@index([organisationId, tipo])
  @@map("plantillas_procedimiento")
}

model PlantillaHito {
  id             String @id @default(cuid(2))
  organisationId String
  plantillaId    String

  orden       Int
  nombre      String
  tipo        TipoHito
  descripcion String?

  /// When set, instantiating this step also creates a Plazo.
  plazoCantidad      Int?
  plazoComputo       ComputoPlazo?
  /// The article this deadline rests on, shown next to every date.
  plazoFundamento    String?
  /// Missing a preclusive deadline forfeits the right; the UI must shout.
  plazoEsPreclusivo  Boolean       @default(false)
  /// Days after the previous milestone, when the step has no legal deadline.
  desplazamientoDias Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plantilla PlantillaProcedimiento @relation(fields: [plantillaId], references: [id], onDelete: Cascade)

  @@unique([plantillaId, orden])
  @@index([organisationId, plantillaId])
  @@map("plantillas_hito")
}

model Expediente {
  id             String @id @default(cuid(2))
  organisationId String

  /// Auto-numbered per organisation: EXP-2026-0001.
  referencia String
  titulo     String
  resumen    String?

  tipo         TipoExpediente
  jurisdiccion Jurisdiccion
  estado       EstadoExpediente @default(ABIERTO)

  contratoId  String?
  plantillaId String?

  /// Free text plus a coarse type, because the exact body varies enormously.
  organoCompetente String?
  numeroAutos      String?
  parteContraria   String?

  cuantia              Decimal? @db.Decimal(14, 2)
  cuantiaIndeterminada Boolean  @default(false)
  provisionContable    Decimal? @db.Decimal(14, 2)

  /// Aligned with accounting provision criteria rather than invented scales.
  probabilidadExito String?

  responsableInternoId String?
  despachoExterno      String?

  fechaApertura   DateTime           @db.Date
  fechaResolucion DateTime?          @db.Date
  sentido         SentidoResolucion?

  importeReclamado  Decimal? @db.Decimal(14, 2)
  importePagado     Decimal? @db.Decimal(14, 2)
  importeRecuperado Decimal? @db.Decimal(14, 2)

  esConfidencial Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contrato     Contrato?               @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  plantilla    PlantillaProcedimiento? @relation(fields: [plantillaId], references: [id], onDelete: SetNull)
  hitos        Hito[]
  plazos       Plazo[]
  actuaciones  Actuacion[]

  comunicaciones    Comunicacion[]
  /// The detections that led here. SPEC calls this `origenDeteccionId`; it
  /// lives on `Deteccion` so the link is a relation (ADR 0004).
  origenDetecciones Deteccion[]
  incidencias       Incidencia[]
  riesgos           Riesgo[]
  documentos        Documento[]

  @@unique([organisationId, referencia])
  @@index([organisationId, estado])
  @@index([organisationId, deletedAt])
  @@index([contratoId])
  @@map("expedientes")
}

model Hito {
  id             String @id @default(cuid(2))
  organisationId String
  expedienteId   String

  orden       Int
  nombre      String
  tipo        TipoHito
  descripcion String?
  estado      EstadoHito @default(PENDIENTE)

  fechaPrevista DateTime? @db.Date
  fechaReal     DateTime? @db.Date

  responsableId String?
  notas         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  plazo      Plazo?

  @@index([organisationId, expedienteId, orden])
  @@map("hitos")
}

model Plazo {
  id             String  @id @default(cuid(2))
  organisationId String
  expedienteId   String
  hitoId         String? @unique

  descripcion String
  /// Always shown beside the date, e.g. "art. 50.1 LCSP — 15 días hábiles".
  fundamento  String

  fechaInicio DateTime     @db.Date
  cantidad    Int
  computo     ComputoPlazo

  /// What the engine computed, and what a person confirmed. They are kept
  /// apart deliberately: an unconfirmed date is never treated as firm.
  fechaVencimientoCalculada  DateTime  @db.Date
  fechaVencimientoConfirmada DateTime? @db.Date
  confirmadaPorId            String?
  confirmadaEn               DateTime?

  /// False when a calendar the calculation depended on was missing or
  /// unverified. Such a deadline must be shown with its warning.
  calculoCompleto Boolean  @default(false)
  advertencias    String[]
  /// The days the engine skipped and why, so the result can be audited.
  diasExcluidos   Json?

  esPreclusivo Boolean     @default(false)
  estado       EstadoPlazo @default(VIGENTE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  hito       Hito?      @relation(fields: [hitoId], references: [id], onDelete: SetNull)

  @@index([organisationId, expedienteId])
  @@index([organisationId, estado, fechaVencimientoCalculada])
  @@map("plazos")
}

/// The docket: everything that happened, in order.
model Actuacion {
  id             String @id @default(cuid(2))
  organisationId String
  expedienteId   String

  fecha       DateTime @db.Date
  tipo        String
  descripcion String
  autorId     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  expediente Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  @@index([organisationId, expedienteId, fecha])
  @@map("actuaciones")
}

/// What kind of thing happened. Coarse on purpose: the detail lives in
/// `accion`, and a small enum keeps the index selective and the dashboards
/// legible.
enum TipoEventoAuditoria {
  CREACION
  MODIFICACION
  BORRADO
  ACCESO
  EXPORTACION
  ACCESO_DENEGADO
  AUTENTICACION
}

/// The audit trail (SPEC §7.3).
///
/// Append-only, enforced by a database trigger rather than by convention: an
/// audit log an application can rewrite is not evidence. Rows survive the
/// deletion of what they describe, so `entidadId` is a plain string and not a
/// foreign key — the point of the record is to outlive the thing.
///
/// Immutable, so it omits updatedAt/deletedAt per ADR 0003.
model AuditEvent {
  id             String @id @default(cuid(2))
  organisationId String

  /// Null for events that happen before anyone is resolved, like a failed
  /// sign-in against an address that does not exist.
  actorId       String?
  actorEmail    String?
  actorRol      Role?
  /// True when the actor was acting through a time-boxed AccessGrant.
  porDelegacion Boolean @default(false)

  tipo        TipoEventoAuditoria
  /// Dotted and stable, e.g. `contrato.crear`, `plazo.confirmar`.
  accion      String
  /// The Prisma model name, e.g. `Contrato`.
  entidad     String
  entidadId   String?
  /// Human-readable at the time of writing, so a deleted record still reads.
  descripcion String?

  /// Only the fields that changed, redacted of secrets by the writer.
  antes   Json?
  despues Json?

  ip        String?
  userAgent String?
  /// Correlates every event produced by one request.
  requestId String?

  createdAt DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
  @@index([organisationId, entidad, entidadId])
  @@index([organisationId, actorId, createdAt])
  @@map("audit_events")
}

/// How correspondence reached us. Manual upload and forwarding alias are the
/// two that need no OAuth; the mailbox types arrive in M8.
enum TipoBuzon {
  CARGA_MANUAL
  ALIAS_REENVIO
  MS365_FUNCIONAL
  GOOGLE_FUNCIONAL
  IMAP
}

enum DireccionComunicacion {
  ENTRANTE
  SALIENTE
}

enum EstadoRevisionComunicacion {
  SIN_REVISAR
  REVISADA
  ARCHIVADA
}

enum EstadoOAuthBuzon {
  PENDIENTE
  ACTIVO
  REQUIERE_ATENCION
  REVOCADO
}

enum ProveedorCorreoOAuth {
  GOOGLE
  MICROSOFT
}

enum EstadoLoteDeteccion {
  EN_PROCESO
  COMPLETADO
  PARCIAL
  ERROR
}

enum EstadoItemLoteDeteccion {
  PENDIENTE
  COMPLETADO
  ERROR
}

/// A source of correspondence (SPEC §4.3).
///
/// `politicaInternaDocumentoId` and `consultaRepresentacionFechaId` are the
/// lawful-basis paperwork for reading a named person's mailbox (LOPDGDD art.
/// 87). They are nullable here because manual upload and a shared alias need
/// neither; the service layer refuses to connect a personal mailbox without
/// them, which is where that rule can actually be enforced.
model BuzonConectado {
  id             String @id @default(cuid(2))
  organisationId String

  tipo      TipoBuzon
  nombre    String
  direccion String?

  contratoId String?

  estadoOAuth          EstadoOAuthBuzon?
  ultimaSincronizacion DateTime?

  /// Provider identity and encrypted delegated credentials. Tokens are never
  /// exposed to the browser or written to the audit log.
  proveedorCuentaId    String?
  tokenAccesoCifrado   String?   @db.Text
  tokenRefrescoCifrado String?   @db.Text
  tokenExpiraEn        DateTime?
  scopesOAuth          String[]  @default([])

  /// Opaque Gmail history id or JSON containing Graph delta links. The app
  /// must never parse or manufacture the provider's state tokens.
  cursorSincronizacion String?   @db.Text
  historicoDesde       DateTime? @db.Date
  errorSincronizacion  String?   @db.Text
  sincronizandoDesde   DateTime?

  /// Functional mailboxes are the safe default. Personal mailboxes are held
  /// behind the Article 87 evidence gate below.
  esPersonal Boolean @default(false)

  politicaInternaDocumentoId    String?
  consultaRepresentacionFecha   DateTime? @db.Date
  /// Legacy placeholder from the original M6 schema. Kept temporarily so a
  /// migration never destroys an unknown value; new code does not write it.
  consultaRepresentacionFechaId String?

  activo Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  organisation    Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contrato        Contrato?       @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  politicaInterna Documento?      @relation("PoliticaBuzon", fields: [politicaInternaDocumentoId], references: [id], onDelete: SetNull)
  comunicaciones  Comunicacion[]
  lotesDeteccion  LoteDeteccion[]

  @@unique([organisationId, direccion])
  @@index([organisationId, tipo])
  @@map("buzones_conectados")
}

/// A cost-efficient Claude Message Batch for an initial mailbox history.
model LoteDeteccion {
  id             String @id @default(cuid(2))
  organisationId String
  buzonId        String

  proveedorLoteId String
  estado          EstadoLoteDeteccion @default(EN_PROCESO)
  total           Int
  completados     Int                 @default(0)
  fallidos        Int                 @default(0)
  modelId         String
  promptVersion   String

  createdAt   DateTime  @default(now())
  createdById String?
  completedAt DateTime?

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  buzon        BuzonConectado      @relation(fields: [buzonId], references: [id], onDelete: Cascade)
  items        ItemLoteDeteccion[]

  @@unique([organisationId, proveedorLoteId])
  @@index([organisationId, estado, createdAt])
  @@map("lotes_deteccion")
}

model ItemLoteDeteccion {
  id             String @id @default(cuid(2))
  organisationId String
  loteId         String
  comunicacionId String

  customId    String
  estado      EstadoItemLoteDeteccion @default(PENDIENTE)
  error       String?                 @db.Text
  completedAt DateTime?
  createdAt   DateTime                @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lote         LoteDeteccion @relation(fields: [loteId], references: [id], onDelete: Cascade)
  comunicacion Comunicacion  @relation(fields: [comunicacionId], references: [id], onDelete: Cascade)

  @@unique([loteId, customId])
  @@unique([loteId, comunicacionId])
  // A message is charged and analysed at most once, even if two operators
  // submit the same mailbox at the same time.
  @@unique([organisationId, comunicacionId])
  @@index([organisationId, estado])
  @@map("items_lote_deteccion")
}

/// One-time, server-side OAuth handshake. The public state is stored only as a
/// SHA-256 hash and is consumed atomically, which prevents both CSRF and replay.
model SolicitudOAuthBuzon {
  id             String @id @default(cuid(2))
  organisationId String

  proveedor           ProveedorCorreoOAuth
  stateHash           String               @unique
  pkceVerifierCifrado String               @db.Text
  solicitadoPorId     String

  contratoId                  String?
  esPersonal                  Boolean   @default(false)
  politicaInternaDocumentoId  String?
  consultaRepresentacionFecha DateTime? @db.Date
  historicoDesde              DateTime? @db.Date

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, expiresAt])
  @@map("solicitudes_oauth_buzon")
}

/// One message (SPEC §4.3).
///
/// Deduplication hangs on two columns, because neither alone is enough. The
/// RFC Message-ID is authoritative when present, but forwarded mail and PDFs
/// of printed mail often have none — so `huella` carries a hash of the parts
/// that identify a message regardless. Both are unique per organisation, and
/// uniqueness is the database's job rather than a check-then-insert that two
/// concurrent uploads would both pass.
model Comunicacion {
  id             String @id @default(cuid(2))
  organisationId String
  buzonId        String

  /// From the RFC 5322 header. Null when the source had none.
  messageIdRFC String?
  /// sha256 of sender + subject + date + body, for sources without a Message-ID.
  huella       String
  threadId     String?

  direccion DireccionComunicacion
  de        String
  para      String[]
  cc        String[]
  asunto    String

  fechaEnvio     DateTime?
  fechaRecepcion DateTime

  cuerpoTexto          String?
  cuerpoHtmlSanitizado String?

  contratoId           String?
  expedienteId         String?
  /// 0–1. How sure the automatic contract match is; 1 means a person chose it.
  confianzaVinculacion Float?

  estadoRevision EstadoRevisionComunicacion @default(SIN_REVISAR)
  esConfidencial Boolean                    @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  buzon              BuzonConectado      @relation(fields: [buzonId], references: [id], onDelete: Cascade)
  contrato           Contrato?           @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  expediente         Expediente?         @relation(fields: [expedienteId], references: [id], onDelete: SetNull)
  adjuntos           Adjunto[]
  detecciones        Deteccion[]
  itemsLoteDeteccion ItemLoteDeteccion[]

  @@unique([organisationId, messageIdRFC])
  @@unique([organisationId, huella])
  @@index([organisationId, fechaRecepcion])
  @@index([organisationId, estadoRevision])
  @@index([contratoId])
  @@map("comunicaciones")
}

enum EstadoAntivirus {
  PENDIENTE
  LIMPIO
  INFECTADO
  NO_ANALIZADO
}

/// An attachment's identity, not yet its bytes.
///
/// Object storage, antivirus and text extraction are M9. Until then the
/// metadata and the hash are recorded so nothing about what arrived is lost,
/// and `storageKey` stays null rather than pointing at somewhere that does not
/// exist yet.
model Adjunto {
  id             String @id @default(cuid(2))
  organisationId String
  comunicacionId String

  nombre   String
  mimeType String
  tamano   Int
  sha256   String

  storageKey      String?
  estadoAntivirus EstadoAntivirus @default(NO_ANALIZADO)
  textoExtraido   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  comunicacion Comunicacion @relation(fields: [comunicacionId], references: [id], onDelete: Cascade)

  @@index([organisationId, comunicacionId])
  @@map("adjuntos")
}

/// What a detection claims to have found (SPEC §4.4).
///
/// The catalogue is closed on purpose: a detection whose type nobody has
/// decided what to do with is a notification, not a signal.
enum TipoDeteccion {
  REQUERIMIENTO_FORMAL
  PREAVISO_PENALIDAD
  INCUMPLIMIENTO_ALEGADO
  RECLAMACION_USUARIO
  QUEJA_FORMAL
  IMPAGO_FACTURA
  SOLICITUD_MODIFICADO
  AMENAZA_RESOLUCION
  INICIO_EXPEDIENTE_SANCIONADOR
  ASUNTO_LABORAL
  SUBROGACION
  SINIESTRO
  PLAZO_MENCIONADO
  RIESGO_PRL
}

enum EstadoDeteccion {
  NUEVA
  CONFIRMADA
  DESCARTADA
  CONVERTIDA
}

/// A proposal about one message, awaiting a person (SPEC §4.4, §6.4).
///
/// Nothing here acts on its own. A detection is a claim plus the literal words
/// that justify it, and those words are verified against the source text by
/// exact substring match before this row is written — see
/// `lib/domain/detecciones/verificacion.ts` and ADR 0006.
///
/// `confianzaModelo` is kept alongside `confianza` because they answer
/// different questions: what the engine claimed, and what survived
/// verification. A widening gap between them is how you notice a prompt
/// starting to invent quotes.
///
/// `modelId` and `promptVersion` are not decoration. When a reviewer says the
/// queue got worse last week, these are what makes that answerable.
model Deteccion {
  id             String @id @default(cuid(2))
  organisationId String

  /// The message this was found in. `notificacionId` joins it when electronic
  /// notifications arrive (SPEC §4.3) — a notification is what starts a legal
  /// clock, so it will carry detections of its own.
  comunicacionId String

  tipo            TipoDeteccion
  /// 0–1, after verification penalties. This is the number the queue sorts on.
  confianza       Float
  /// 0–1, as claimed by the engine before any quote was checked.
  confianzaModelo Float

  /// Array of `{texto, inicioChar, finChar}` — quotes verified against the
  /// source. Offsets are the server's own, never the engine's.
  extractos            Json
  /// How many proposed quotes did not appear in the source and were dropped.
  extractosDescartados Int  @default(0)

  /// Typed by `tipo`: amounts, dates, articles cited, deadline mentioned.
  datosExtraidos Json?

  estado         EstadoDeteccion @default(NUEVA)
  revisadaPorId  String?
  revisadaEn     DateTime?
  /// Free text on discard. Feeds prompt tuning, so it is worth asking for.
  motivoDescarte String?

  /// Set when confirming this detection opened an expediente. The inverse of
  /// SPEC's `Expediente.origenDeteccionId`, kept on this side so the link is a
  /// relation rather than a loose id (ADR 0004).
  expedienteId String?

  modelId       String
  promptVersion String
  costeTokens   Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  comunicacion Comunicacion @relation(fields: [comunicacionId], references: [id], onDelete: Cascade)
  expediente   Expediente?  @relation(fields: [expedienteId], references: [id], onDelete: SetNull)

  /// One finding of each kind per message. Re-analysing a message must refresh
  /// what is still pending, not pile a second copy on top of it — and must
  /// never resurrect something a person already discarded.
  @@unique([organisationId, comunicacionId, tipo])
  @@index([organisationId, estado, confianza])
  @@map("detecciones")
}

/// What happened (SPEC §4.6). The list is the one a prevention officer and a
/// contract manager both recognise, because the same event is often reportable
/// under two regimes at once.
enum TipoIncidencia {
  ACCIDENTE
  INCIDENTE_SIN_BAJA
  DANO_MATERIAL
  FALLO_SERVICIO
  QUEJA_USUARIO
  AGRESION
  MEDIOAMBIENTAL
  VEHICULO
  SEGURIDAD_DATOS
}

enum GravedadIncidencia {
  LEVE
  MODERADA
  GRAVE
  MUY_GRAVE
}

enum EstadoIncidencia {
  ABIERTA
  EN_INVESTIGACION
  CERRADA
  REABIERTA
}

/// An operational fact (SPEC §4.6).
///
/// Separate from `Expediente` on purpose: most incidents never become a
/// procedure, and the ones that do need the record of what happened to have
/// existed *before* anybody was arguing about it. `expedienteId` is the link
/// for when one escalates.
///
/// `personasImplicadas` holds an AES-256-GCM envelope, never plaintext. It can
/// contain Article 9 data after an accident or assault, so reads require an
/// additional permission and always emit an audit event.
model Incidencia {
  id             String @id @default(cuid(2))
  organisationId String

  /// Auto-numbered per organisation and year: INC-2026-0001.
  referencia String

  contratoId String?

  tipo     TipoIncidencia
  gravedad GravedadIncidencia
  estado   EstadoIncidencia   @default(ABIERTA)

  /// When it happened, and when we were told — rarely the same, and the gap
  /// is itself evidence in a dispute about diligence.
  fechaHecho        DateTime
  fechaComunicacion DateTime?

  lugar               String?
  descripcion         String
  medidasInmediatas   String?
  causaRaiz           String?
  leccionesAprendidas String?
  fechaCierre         DateTime? @db.Date

  /// JSONB envelope `{ version, cifrado }`; the decrypted payload never enters Prisma.
  personasImplicadas Json?

  /// Told the contracting authority. A penalty for late notice usually turns
  /// on this and its date.
  comunicadaAlOrgano         Boolean   @default(false)
  fechaComunicacionOrgano    DateTime?
  /// Reportable to a public authority — Delt@ for accidents, the AEPD for a
  /// data breach. A flag a person sets, never inferred.
  esNotificableAAutoridad    Boolean   @default(false)
  notificadaAAutoridad       Boolean   @default(false)
  fechaNotificacionAutoridad DateTime?
  referenciaAutoridad        String?

  expedienteId String?
  /// The detection this came from, when a person confirmed one.
  deteccionId  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contrato     Contrato?          @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  expediente   Expediente?        @relation(fields: [expedienteId], references: [id], onDelete: SetNull)
  acciones     AccionCorrectora[]
  riesgos      Riesgo[]
  documentos   Documento[]

  @@unique([organisationId, referencia])
  @@index([organisationId, estado, fechaHecho])
  @@index([contratoId])
  @@map("incidencias")
}

/// How the organisation intends to deal with it. The four standard responses.
enum RespuestaRiesgo {
  EVITAR
  MITIGAR
  TRANSFERIR
  ACEPTAR
}

enum EstadoRiesgo {
  IDENTIFICADO
  EN_TRATAMIENTO
  CONTROLADO
  MATERIALIZADO
  CERRADO
}

/// Something that has not happened yet (SPEC §4.6).
///
/// Written as cause → event → consequence rather than one free-text line,
/// because "riesgo de penalidad" is not a risk anybody can act on, and the
/// three parts are what make the difference between a register that gets
/// reviewed and one that gets filed.
///
/// Scores are stored as the 1–5 inputs, never as the product. The matrix
/// bands are the application's to change; a stored total would freeze
/// yesterday's matrix into the data.
model Riesgo {
  id             String @id @default(cuid(2))
  organisationId String

  referencia String

  categoriaId String?
  contratoId  String?

  causa        String
  evento       String
  consecuencia String

  /// 1–5 each, before any control is applied.
  probabilidadInherente Int
  impactoInherente      Int

  respuesta RespuestaRiesgo @default(MITIGAR)
  controles String?

  /// 1–5 each, after the controls above. Null until somebody has assessed
  /// them — an unassessed residual is not the same as an unchanged one.
  probabilidadResidual Int?
  impactoResidual      Int?

  estado EstadoRiesgo @default(IDENTIFICADO)

  responsableId          String?
  frecuenciaRevisionDias Int       @default(90)
  /// Risk registers rot. This is the date somebody has to look again.
  proximaRevision        DateTime? @db.Date
  ultimaRevision         DateTime? @db.Date

  /// Set when the risk stopped being hypothetical.
  incidenciaId String?
  expedienteId String?
  deteccionId  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  organisation           Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  categoria              CategoriaRiesgo?   @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  contrato               Contrato?          @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  incidencia             Incidencia?        @relation(fields: [incidenciaId], references: [id], onDelete: SetNull)
  expediente             Expediente?        @relation(fields: [expedienteId], references: [id], onDelete: SetNull)
  acciones               AccionCorrectora[]
  controlesEstructurados ControlRiesgo[]
  valoraciones           ValoracionRiesgo[]
  revisiones             RevisionRiesgo[]

  @@unique([organisationId, referencia])
  @@index([organisationId, estado])
  @@index([organisationId, categoriaId, estado])
  @@index([organisationId, proximaRevision])
  @@index([contratoId])
  @@map("riesgos")
}

/// Tenant-configurable taxonomy. `clave` is a stable import/detection key;
/// `nombre` is what each organisation shows to its users.
model CategoriaRiesgo {
  id             String @id @default(cuid(2))
  organisationId String

  clave       String
  nombre      String
  descripcion String?
  color       String
  orden       Int
  isActive    Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  riesgos      Riesgo[]

  @@unique([organisationId, clave])
  @@unique([organisationId, nombre])
  @@index([organisationId, isActive, orden])
  @@map("categorias_riesgo")
}

enum NivelMatrizRiesgo {
  BAJO
  MEDIO
  ALTO
  MUY_ALTO
}

/// Tenant-owned risk bands. The 5x5 inputs stay stable while each organisation
/// may tune which products fall into each named band.
model BandaRiesgo {
  id             String @id @default(cuid(2))
  organisationId String

  nivel            NivelMatrizRiesgo
  nombre           String
  puntuacionMinima Int
  puntuacionMaxima Int
  color            String
  orden            Int

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, nivel])
  @@index([organisationId, orden])
  @@map("bandas_riesgo")
}

enum TipoControlRiesgo {
  PREVENTIVO
  DETECTIVO
  CORRECTIVO
  DIRECTIVO
}

enum EficaciaControlRiesgo {
  NO_EVALUADO
  INEFICAZ
  PARCIAL
  EFICAZ
}

/// A named control whose existence and effectiveness can be reviewed instead
/// of disappearing inside a free-text risk description.
model ControlRiesgo {
  id             String @id @default(cuid(2))
  organisationId String
  riesgoId       String

  titulo      String
  descripcion String
  tipo        TipoControlRiesgo
  eficacia    EficaciaControlRiesgo @default(NO_EVALUADO)
  esExistente Boolean               @default(true)

  responsableId String?
  ultimaPrueba  DateTime? @db.Date
  proximaPrueba DateTime? @db.Date

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  riesgo       Riesgo       @relation(fields: [riesgoId], references: [id], onDelete: Cascade)

  @@index([organisationId, riesgoId, deletedAt])
  @@index([organisationId, eficacia])
  @@map("controles_riesgo")
}

enum TipoValoracionRiesgo {
  INICIAL
  REVISION
  REVALORACION
}

/// Immutable scoring snapshot. If a score was wrong, a compensating snapshot
/// is appended; history is never rewritten (ADR 0003).
model ValoracionRiesgo {
  id             String @id @default(cuid(2))
  organisationId String
  riesgoId       String

  tipo TipoValoracionRiesgo

  probabilidadInherente Int
  impactoInherente      Int
  puntuacionInherente   Int
  nivelInherente        NivelMatrizRiesgo

  probabilidadResidual Int?
  impactoResidual      Int?
  puntuacionResidual   Int?
  nivelResidual        NivelMatrizRiesgo?

  justificacion String
  bandas        Json
  valoradaEn    DateTime @default(now())
  valoradaPorId String

  createdAt   DateTime @default(now())
  createdById String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  riesgo       Riesgo       @relation(fields: [riesgoId], references: [id], onDelete: Cascade)

  @@index([organisationId, riesgoId, valoradaEn])
  @@map("valoraciones_riesgo")
}

enum ResultadoRevisionRiesgo {
  SIN_CAMBIOS
  REVALORADO
  CONTROL_ACTUALIZADO
  MATERIALIZADO
  CERRADO
}

/// Immutable evidence that somebody reviewed the risk on its due date.
model RevisionRiesgo {
  id             String @id @default(cuid(2))
  organisationId String
  riesgoId       String

  resultado       ResultadoRevisionRiesgo
  comentarios     String
  revisadaEn      DateTime                @default(now())
  revisadaPorId   String
  proximaRevision DateTime?               @db.Date

  createdAt   DateTime @default(now())
  createdById String

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  riesgo       Riesgo       @relation(fields: [riesgoId], references: [id], onDelete: Cascade)

  @@index([organisationId, riesgoId, revisadaEn])
  @@index([organisationId, proximaRevision])
  @@map("revisiones_riesgo")
}

enum EstadoAccion {
  PENDIENTE
  EN_CURSO
  BLOQUEADA
  COMPLETADA
  VERIFICADA
  CANCELADA
}

enum PrioridadAccion {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

/// What somebody committed to do about it (SPEC §12, M10).
///
/// Hangs off an incidencia or a riesgo — at least one, and the check that
/// enforces "at least one" lives in the database, because an action attached
/// to nothing is invisible to every screen that would have shown it.
///
/// `VERIFICADA` is deliberately distinct from `COMPLETADA`: an ISO 9001 or
/// 45001 audit asks who checked that the fix worked, and "we did it" is not an
/// answer to that question.
model AccionCorrectora {
  id             String @id @default(cuid(2))
  organisationId String

  incidenciaId String?
  riesgoId     String?

  titulo        String          @default("Acción correctora")
  descripcion   String
  estado        EstadoAccion    @default(PENDIENTE)
  prioridad     PrioridadAccion @default(MEDIA)
  progreso      Int             @default(0)
  motivoBloqueo String?

  responsableId String?
  fechaLimite   DateTime? @db.Date
  fechaCierre   DateTime? @db.Date

  /// Who confirmed it actually worked, and when.
  verificadaPorId String?
  verificadaEn    DateTime?
  eficacia        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  deletedAt   DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  incidencia   Incidencia?  @relation(fields: [incidenciaId], references: [id], onDelete: Cascade)
  riesgo       Riesgo?      @relation(fields: [riesgoId], references: [id], onDelete: Cascade)

  @@index([organisationId, estado, fechaLimite])
  @@index([incidenciaId])
  @@index([riesgoId])
  @@map("acciones_correctoras")
}

/// Antivirus verdict on a stored file (SPEC §4.6).
enum EstadoAnalisis {
  PENDIENTE
  LIMPIO
  INFECTADO
  NO_ANALIZADO
}

/// Where a version is in the extraction/OCR pipeline. This is deliberately
/// separate from antivirus: a clean scanned PDF may still be waiting for OCR.
enum EstadoIndexacion {
  PENDIENTE
  EXTRAIDO
  OCR_PENDIENTE
  OCR_COMPLETADO
  OCR_PARCIAL
  NO_SOPORTADO
  ERROR
}

/// A kind of document, configurable per tenant and seeded in Spanish.
///
/// Retention lives here rather than on each document: policy is a property of
/// the class of document, and putting it on the instance is how two invoices
/// end up with different retention because two people typed different numbers.
model TipoDocumento {
  id             String @id @default(cuid(2))
  organisationId String

  nombre         String
  codigo         String
  /// Years to keep it after the retention clock starts. Null means "no policy
  /// yet", which is different from "keep forever" and is shown as such.
  retencionAnios Int?
  /// Whether the tenant may delete it before retention expires.
  esObligatorio  Boolean @default(false)
  esDelSistema   Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  documentos   Documento[]

  @@unique([organisationId, codigo])
  @@map("tipos_documento")
}

/// A document: the identity, the classification and the links (SPEC §4.6).
///
/// The bytes are not here. A document is a named thing with a history, and its
/// history is a list of versions — so the current content is "the newest
/// version", never a column on this row that an update could quietly replace.
model Documento {
  id             String @id @default(cuid(2))
  organisationId String

  nombre      String
  descripcion String?
  tipoId      String?

  /// What it belongs to. All optional and not mutually exclusive: a resolution
  /// belongs to an expediente and to the contract underneath it.
  contratoId   String?
  expedienteId String?
  incidenciaId String?

  /// Set when the document is evidence somebody must not delete — a retention
  /// hold in the litigation sense. Blocks deletion regardless of policy.
  bloqueadoPorLitigio Boolean   @default(false)
  bloqueadoEn         DateTime?
  bloqueadoPorId      String?
  motivoBloqueo       String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  deletedAt     DateTime?
  deletedById   String?
  motivoBorrado String?
  restoredAt    DateTime?
  restoredById  String?

  organisation    Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  tipo            TipoDocumento?          @relation(fields: [tipoId], references: [id], onDelete: SetNull)
  contrato        Contrato?               @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  expediente      Expediente?             @relation(fields: [expedienteId], references: [id], onDelete: SetNull)
  incidencia      Incidencia?             @relation(fields: [incidenciaId], references: [id], onDelete: SetNull)
  versiones       VersionDocumento[]
  buzonesPolitica BuzonConectado[]        @relation("PoliticaBuzon")
  conveniosFuente ConvenioColectivo[]     @relation("ConvenioDocumento")
  certificaciones CertificacionEmpleado[] @relation("CertificacionDocumento")

  @@index([organisationId, createdAt])
  @@index([organisationId, deletedAt, createdAt])
  @@index([expedienteId])
  @@index([contratoId])
  @@index([incidenciaId])
  @@map("documentos")
}

/// One version's bytes and their provenance.
///
/// Append-only in spirit and nearly so in fact: a new upload is a new row, and
/// nothing rewrites an existing one except the antivirus verdict, which is a
/// fact about the file that arrives after it was stored. `deletedAt` exists
/// only so a retention purge can record that the bytes went.
///
/// `sha256` is both the integrity check and the object key, so a version whose
/// bytes were tampered with cannot be served: the read verifies the hash.
model VersionDocumento {
  id             String @id @default(cuid(2))
  organisationId String
  documentoId    String

  /// 1, 2, 3… per document. The newest is the current one.
  numero     Int
  nombre     String
  mimeType   String
  tamano     Int
  sha256     String
  /// Key in object storage. Content-addressed, so two versions with identical
  /// bytes share it.
  storageKey String

  estadoAnalisis EstadoAnalisis @default(PENDIENTE)
  analizadoEn    DateTime?
  /// What the scanner said when it refused it. Kept for the audit trail.
  motivoAnalisis String?

  /// Extracted for search. Null until extraction runs, empty for a file that
  /// genuinely has no text.
  textoExtraido    String?
  estadoIndexacion EstadoIndexacion @default(PENDIENTE)
  motivoIndexacion String?
  indexadoEn       DateTime?
  ocrPaginas       Int?
  ocrConfianza     Float?

  createdAt   DateTime  @default(now())
  createdById String?
  deletedAt   DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  documento    Documento    @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@unique([documentoId, numero])
  @@index([organisationId, sha256])
  @@map("versiones_documento")
}

// ---------------------------------------------------------------------------
// M11 — Personal, convenio y adscripción
// ---------------------------------------------------------------------------

enum AmbitoConvenio {
  ESTATAL
  AUTONOMICO
  PROVINCIAL
  EMPRESA
  CENTRO
}

enum EstadoEmpleado {
  ACTIVO
  EXCEDENCIA
  BAJA
  FINALIZADO
}

enum MotivoReduccionJornada {
  GUARDA_LEGAL
  LACTANCIA
  CUIDADO_FAMILIAR
  OTRO
}

enum FuentePlantillaExigida {
  PCAP
  PPT
  OFERTA
  MODIFICADO
}

enum TurnoTrabajo {
  MANANA
  TARDE
  NOCHE
  PARTIDO
  ROTATIVO
  OTRO
}

enum EstadoCertificacion {
  VALIDA
  PROXIMA_A_CADUCAR
  CADUCADA
  PENDIENTE_RENOVACION
  REVOCADA
}

/// Public collective agreement metadata and its effective period. Salary
/// tables are versioned children: changing a published amount creates a new
/// effective row instead of rewriting the basis used by an earlier decision.
model ConvenioColectivo {
  id             String @id @default(cuid(2))
  organisationId String

  nombre           String
  ambito           AmbitoConvenio
  sector           String
  provincia        String?
  codigoBoletin    String?
  fechaPublicacion DateTime?      @db.Date
  vigenciaDesde    DateTime       @db.Date
  vigenciaHasta    DateTime?      @db.Date
  enUltraactividad Boolean        @default(false)
  urlBoletin       String?
  documentoId      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  documento    Documento?             @relation("ConvenioDocumento", fields: [documentoId], references: [id], onDelete: SetNull)
  categorias   CategoriaProfesional[]
  tablas       TablaSalarial[]
  contratos    ContratoConvenio[]
  empleados    Empleado[]

  @@index([organisationId, sector, vigenciaDesde])
  @@index([organisationId, deletedAt])
  @@index([documentoId])
  @@map("convenios_colectivos")
}

model ContratoConvenio {
  id             String @id @default(cuid(2))
  organisationId String
  contratoId     String
  convenioId     String

  esPrincipal   Boolean   @default(false)
  vigenciaDesde DateTime? @db.Date
  vigenciaHasta DateTime? @db.Date

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contrato     Contrato          @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  convenio     ConvenioColectivo @relation(fields: [convenioId], references: [id], onDelete: Cascade)

  @@unique([contratoId, convenioId, vigenciaDesde])
  @@index([organisationId, contratoId])
  @@index([organisationId, convenioId])
  @@map("contratos_convenios")
}

model CategoriaProfesional {
  id             String @id @default(cuid(2))
  organisationId String
  convenioId     String

  grupo             String
  nivel             String?
  denominacion      String
  grupoCotizacionSS Int

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation  Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  convenio      ConvenioColectivo     @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  tablas        TablaSalarial[]
  empleados     Empleado[]
  adscripciones AdscripcionContrato[]
  plantillas    PlantillaExigida[]

  @@unique([convenioId, grupo, nivel])
  @@index([organisationId, convenioId])
  @@index([organisationId, denominacion])
  @@map("categorias_profesionales")
}

model TablaSalarial {
  id             String @id @default(cuid(2))
  organisationId String
  convenioId     String
  categoriaId    String

  ano                 Int
  salarioBaseMensual  Decimal  @db.Decimal(12, 2)
  numeroPagas         Int
  jornadaAnualHoras   Decimal  @db.Decimal(8, 2)
  precioHoraOrdinaria Decimal  @db.Decimal(12, 4)
  precioHoraExtra     Decimal? @db.Decimal(12, 4)
  vigenciaDesde       DateTime @db.Date

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  convenio     ConvenioColectivo    @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  categoria    CategoriaProfesional @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, ano, vigenciaDesde])
  @@index([organisationId, convenioId, ano])
  @@index([organisationId, categoriaId, ano])
  @@map("tablas_salariales")
}

/// Employee directory data is deliberately split from protected fields. The
/// encrypted payloads hold NIF/NSS/CCC and individual remuneration or Article
/// 9 facts; list screens never need to decrypt them.
model Empleado {
  id             String @id @default(cuid(2))
  organisationId String

  numeroEmpleado String
  nombre         String
  apellidos      String
  email          String?
  telefono       String?
  puesto         String?
  estado         EstadoEmpleado @default(ACTIVO)
  fechaAlta      DateTime       @db.Date
  fechaBaja      DateTime?      @db.Date

  nifHash                     String?
  datosIdentificacionCifrados String?
  datosLaboralesCifrados      String?

  categoriaId                 String?
  convenioId                  String?
  codigoContratoSEPE          String?
  grupoCotizacion             Int?
  jornadaPorcentaje           Decimal  @default(100) @db.Decimal(5, 2)
  horasSemanales              Decimal  @db.Decimal(6, 2)
  antiguedadReconocida        DateTime @db.Date
  esSubrogado                 Boolean  @default(false)
  contratoOrigenSubrogacionId String?
  tieneReduccionJornada       Boolean  @default(false)
  esRepresentanteTrabajadores Boolean  @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation              Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  categoria                 CategoriaProfesional?   @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  convenio                  ConvenioColectivo?      @relation(fields: [convenioId], references: [id], onDelete: SetNull)
  contratoOrigenSubrogacion Contrato?               @relation("ContratoOrigenSubrogacion", fields: [contratoOrigenSubrogacionId], references: [id], onDelete: SetNull)
  adscripciones             AdscripcionContrato[]
  certificaciones           CertificacionEmpleado[]

  @@unique([organisationId, numeroEmpleado])
  @@unique([organisationId, nifHash])
  @@index([organisationId, estado, apellidos])
  @@index([organisationId, convenioId])
  @@index([organisationId, categoriaId])
  @@index([contratoOrigenSubrogacionId])
  @@map("empleados")
}

model PlantillaExigida {
  id             String @id @default(cuid(2))
  organisationId String
  contratoId     String
  categoriaId    String

  centroTrabajo     String
  numeroPersonas    Int
  horasSemanales    Decimal                @db.Decimal(8, 2)
  fuente            FuentePlantillaExigida
  clausula          String
  esVinculante      Boolean                @default(true)
  penalidadAsociada Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contrato     Contrato             @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  categoria    CategoriaProfesional @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  @@index([organisationId, contratoId, centroTrabajo])
  @@index([organisationId, categoriaId])
  @@map("plantillas_exigidas")
}

model AdscripcionContrato {
  id             String @id @default(cuid(2))
  organisationId String
  empleadoId     String
  contratoId     String
  categoriaId    String

  centroTrabajo        String
  horasSemanales       Decimal      @db.Decimal(6, 2)
  porcentajeDedicacion Decimal      @db.Decimal(5, 2)
  fechaAlta            DateTime     @db.Date
  fechaBaja            DateTime?    @db.Date
  esPersonalClave      Boolean      @default(false)
  turno                TurnoTrabajo @default(MANANA)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  empleado     Empleado             @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  contrato     Contrato             @relation(fields: [contratoId], references: [id], onDelete: Cascade)
