model TipoCertificacion {
  id             String @id @default(cuid(2))
  organisationId String

  codigo                 String
  nombre                 String
  periodoRenovacionMeses Int?
  diasAviso              Int     @default(90)
  esObligatoria          Boolean @default(false)
  isActive               Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation    Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  certificaciones CertificacionEmpleado[]

  @@unique([organisationId, codigo])
  @@index([organisationId, isActive, nombre])
  @@map("tipos_certificacion")
}

model CertificacionEmpleado {
  id             String @id @default(cuid(2))
  organisationId String
  empleadoId     String
  tipoId         String

  referenciaCifrada String?
  emitidaPor        String?
  fechaEmision      DateTime?           @db.Date
  fechaCaducidad    DateTime?           @db.Date
  estado            EstadoCertificacion @default(VALIDA)
  documentoId       String?
  verificadaPorId   String?
  verificadaEn      DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  empleado     Empleado          @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  tipo         TipoCertificacion @relation(fields: [tipoId], references: [id], onDelete: Restrict)
  documento    Documento?        @relation("CertificacionDocumento", fields: [documentoId], references: [id], onDelete: SetNull)

  @@index([organisationId, estado, fechaCaducidad])
  @@index([organisationId, empleadoId])
  @@index([organisationId, tipoId])
  @@index([documentoId])
  @@map("certificaciones_empleado")
}
